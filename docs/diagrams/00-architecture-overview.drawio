<mxfile host="app.diagrams.net" type="device">
  <diagram name="At a glance" id="hep-overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1980" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="txt-1" value="&lt;b&gt;hybrid-edge-platform: architecture at a glance&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=32;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1700" height="46" as="geometry" /></mxCell>
        <mxCell id="txt-2" value="An Azure hub and an edge site that must keep working when the link between them is slow or cut.&lt;br&gt;Everything is built from code, every service has its own short-lived identity, and the numbers follow the main flows." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1700" height="60" as="geometry" /></mxCell>
        <mxCell id="layer-3" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1720" height="210" as="geometry" /></mxCell>
        <mxCell id="txt-4" value="&lt;b&gt;DELIVERY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;Code and pipelines&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;GitHub&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#333333&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Nothing is clicked together&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;in the portal. Every change&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;is a pull request.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=28;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="64" y="182" width="280" height="180" as="geometry" /></mxCell>
        <mxCell id="box-5" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Signs in with Entra ID and MFA.&lt;br&gt;Admin roles only through PIM.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="205" width="280" height="130" as="geometry" /></mxCell>
        <mxCell id="box-6" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Plans, scans and applies on merge.&lt;br&gt;Signs in to Azure with OIDC,&lt;br&gt;no stored secrets.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="205" width="320" height="130" as="geometry" /></mxCell>
        <mxCell id="box-7" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Builds the Azure side.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1130" y="205" width="220" height="130" as="geometry" /></mxCell>
        <mxCell id="box-8" value="&lt;b&gt;Ansible&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Configures the&lt;br&gt;edge nodes.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1400" y="205" width="160" height="130" as="geometry" /></mxCell>
        <mxCell id="txt-10" value="PR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="694" y="244" width="40" height="22" as="geometry" /></mxCell>
        <mxCell id="txt-14" value="sign in" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="552" y="380" width="200" height="22" as="geometry" /></mxCell>
        <mxCell id="layer-21" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1720" height="470" as="geometry" /></mxCell>
        <mxCell id="txt-22" value="&lt;b&gt;AZURE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#1f3a5f&quot;&gt;&lt;b&gt;Cloud hub&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Norway East&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#333333&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Holds identity, secrets,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;policy and monitoring.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Issues the certificates&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;the edge depends on.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=28;fontColor=#1f3a5f;" vertex="1" parent="1"><mxGeometry x="64" y="442" width="280" height="440" as="geometry" /></mxCell>
        <mxCell id="box-23" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Users, groups, RBAC and&lt;br&gt;Conditional Access. Trusts&lt;br&gt;the issuer for federation.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="280" height="150" as="geometry" /></mxCell>
        <mxCell id="box-24" value="&lt;b&gt;Microsoft Sentinel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Reads Log Analytics and&lt;br&gt;alerts when a removed&lt;br&gt;identity is still in use.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="470" width="260" height="150" as="geometry" /></mxCell>
        <mxCell id="box-25" value="&lt;b&gt;Azure Policy and Defender&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Guardrails on every resource and&lt;br&gt;a security posture score for&lt;br&gt;the whole subscription.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="360" height="150" as="geometry" /></mxCell>
        <mxCell id="box-26" value="&lt;b&gt;Certificate issuer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;SPIRE server on a small AKS&lt;br&gt;cluster. Gives every edge service&lt;br&gt;a short-lived certificate.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="280" height="150" as="geometry" /></mxCell>
        <mxCell id="box-27" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Secrets and keys the edge&lt;br&gt;services fetch without&lt;br&gt;storing any themselves.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="690" width="260" height="150" as="geometry" /></mxCell>
        <mxCell id="box-28" value="&lt;b&gt;Hub network&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;VNet, NSGs and a small gateway VM&lt;br&gt;that ends the WireGuard tunnel&lt;br&gt;from the edge site.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="690" width="360" height="150" as="geometry" /></mxCell>
        <mxCell id="box-29" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Prometheus and Grafana&lt;br&gt;for metrics, Log Analytics&lt;br&gt;for logs.&lt;br&gt;&lt;br&gt;Budget alerts keep&lt;br&gt;the bill visible.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="470" width="200" height="370" as="geometry" /></mxCell>
        <mxCell id="txt-31" value="OIDC trust" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=15;fontColor=#4a6fa5;" vertex="1" parent="1"><mxGeometry x="552" y="644" width="200" height="22" as="geometry" /></mxCell>
        <mxCell id="txt-33" value="&lt;b&gt;TB1 across the WAN&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1320" y="893" width="300" height="22" as="geometry" /></mxCell>
        <mxCell id="layer-34" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1720" height="180" as="geometry" /></mxCell>
        <mxCell id="txt-35" value="&lt;b&gt;WAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#4b2a5c&quot;&gt;&lt;b&gt;Site-to-cloud link&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Internet, 4G or satellite&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#333333&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Slow, lossy or cut. The thesis&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;degrades it on purpose.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=28;fontColor=#4b2a5c;" vertex="1" parent="1"><mxGeometry x="64" y="972" width="280" height="150" as="geometry" /></mxCell>
        <mxCell id="box-36" value="&lt;b&gt;WireGuard tunnel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Cut and degraded with tc netem.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="1000" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="layer-48" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1720" height="280" as="geometry" /></mxCell>
        <mxCell id="txt-49" value="&lt;b&gt;EDGE SITE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#2d4d1f&quot;&gt;&lt;b&gt;Substation, clinic or ship&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;K3s on two or more nodes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#333333&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Runs the local services&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;and must keep working&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;while the WAN is down.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=28;fontColor=#2d4d1f;" vertex="1" parent="1"><mxGeometry x="64" y="1182" width="280" height="250" as="geometry" /></mxCell>
        <mxCell id="box-50" value="&lt;b&gt;SPIRE agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;One per node. Proves which&lt;br&gt;node it runs on and keeps the&lt;br&gt;certificates of local services.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="1230" width="280" height="150" as="geometry" /></mxCell>
        <mxCell id="box-51" value="&lt;b&gt;Edge services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Small Go services that&lt;br&gt;only talk to each other&lt;br&gt;over mutual TLS.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="1230" width="260" height="150" as="geometry" /></mxCell>
        <mxCell id="box-52" value="&lt;b&gt;Nodes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Hardened Linux, K3s and WireGuard, set up by Ansible.&lt;br&gt;A local issuer on the site is a planned extension.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="1230" width="680" height="150" as="geometry" /></mxCell>
        <mxCell id="txt-54" value="certs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="688" y="1278" width="60" height="22" as="geometry" /></mxCell>
        <mxCell id="layer-55" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;container=1;collapsible=0;recursiveResize=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="1720" height="220" as="geometry" /></mxCell>
        <mxCell id="txt-56" value="&lt;b&gt;CLIENTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#5c3d00&quot;&gt;&lt;b&gt;Devices and load&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#555555&quot;&gt;Same site network&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#333333&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;Simulated devices, a load&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#333333&quot;&gt;generator and an attacker.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=28;fontColor=#5c3d00;" vertex="1" parent="1"><mxGeometry x="64" y="1492" width="280" height="190" as="geometry" /></mxCell>
        <mxCell id="box-57" value="&lt;b&gt;Clients and load&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Simulated devices and&lt;br&gt;Fortio as load generator.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="1530" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="box-58" value="&lt;b&gt;Attacker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#333333&quot;&gt;Holds a copy of a removed&lt;br&gt;service&amp;#x27;s certificate and key.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=19;fontColor=#222222;spacing=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="1530" width="360" height="120" as="geometry" /></mxCell>
        <mxCell id="txt-63" value="stolen certificate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1132" y="1442" width="260" height="22" as="geometry" /></mxCell>
        <mxCell id="txt-64" value="&lt;b&gt;The main flows&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="600" height="34" as="geometry" /></mxCell>
        <mxCell id="card-65" value="&lt;b&gt;Provision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#333333&quot;&gt;Merging to main runs Terraform&lt;br&gt;for Azure and Ansible for the&lt;br&gt;edge nodes. The pipeline gets&lt;br&gt;a short-lived Azure token (OIDC).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="328" height="150" as="geometry" /></mxCell>
        <mxCell id="card-67" value="&lt;b&gt;Issue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#333333&quot;&gt;The SPIRE agent proves which&lt;br&gt;node it is on and fetches&lt;br&gt;short-lived certificates from&lt;br&gt;the issuer, across the WAN.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="388" y="1790" width="328" height="150" as="geometry" /></mxCell>
        <mxCell id="card-69" value="&lt;b&gt;Serve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#333333&quot;&gt;Services get their certificates&lt;br&gt;from the local agent and accept&lt;br&gt;only requests over mutual TLS.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="736" y="1790" width="328" height="150" as="geometry" /></mxCell>
        <mxCell id="card-71" value="&lt;b&gt;Federate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#333333&quot;&gt;A service swaps its identity for&lt;br&gt;an Entra token and reads Key&lt;br&gt;Vault. No secret is stored on&lt;br&gt;the site.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1084" y="1790" width="328" height="150" as="geometry" /></mxCell>
        <mxCell id="card-73" value="&lt;b&gt;Observe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#333333&quot;&gt;Metrics and logs go to Azure.&lt;br&gt;Sentinel raises an alert when&lt;br&gt;the attacker uses a removed&lt;br&gt;certificate.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1432" y="1790" width="328" height="150" as="geometry" /></mxCell>
